+// TestLeastLoadRejectionReasons checks every filter arm reports the right code,
+// including the synthesized one upstream has no concept of.
+func TestLeastLoadRejectionReasons(t *testing.T) {
+	s := newLeastLoad(t,
+		&StrategyLeastLoadConfig{
+			Expected:  1,
+			MaxRTT:    int64(300 * time.Millisecond),
+			Tolerance: 0.3,
+		},
+		status("ok", true, 100, 10, 0, int64(10*time.Millisecond), int64(100*time.Millisecond)),
+		status("dead", false, 100, 10, 10, int64(10*time.Millisecond), int64(100*time.Millisecond)),
+		status("slow", true, 400, 10, 0, int64(10*time.Millisecond), int64(400*time.Millisecond)),
+		status("flaky", true, 100, 10, 5, int64(10*time.Millisecond), int64(100*time.Millisecond)),
+		status("elsewhere", true, 10, 10, 0, int64(1*time.Millisecond), int64(10*time.Millisecond)),
+	)
+	// "never-probed" is a candidate with no observation record at all.
+	candidates := []string{"ok", "dead", "slow", "flaky", "never-probed"}
+
+	traces := withTracing(t, func() {
+		b := newBalancer(s, "leastload", "", candidates)
+		if _, err := b.PickOutboundWithConn(7); err != nil {
+			t.Fatalf("pick: %v", err)
+		}
+	})
+	if len(traces) != 1 {
+		t.Fatalf("expected 1 trace, got %d", len(traces))
+	}
+	filter := findStage(traces[0], xraytrace.StageNodeFilter)
+	if filter == nil {
+		t.Fatal("no node_filter stage")
+	}
+
+	for tag, want := range map[string]string{
+		"dead":         xraytrace.ReasonNotAlive,
+		"slow":         xraytrace.ReasonMaxRTT,
+		"flaky":        xraytrace.ReasonTolerance,
+		"never-probed": xraytrace.ReasonNotInObservation,
+	} {
+		if got := rejectionReason(filter, tag); got != want {
+			t.Errorf("%s: reason = %q, want %q", tag, got, want)
+		}
+	}
+	if len(filter.Out) != 1 || filter.Out[0] != "ok" {
+		t.Errorf("survivors = %v, want [ok]", filter.Out)
+	}
+	// "elsewhere" is in the observation but outside the candidate set. It is not a
+	// rejection the user cares about, so it must not clutter the funnel.
+	if r := rejectionReason(filter, "elsewhere"); r != "" {
+		t.Errorf("non-candidate should not be reported as rejected, got %q", r)
+	}
+}
+
+// TestLeastLoadScoreArithmetic pins the score formula: deviation * sqrt(costWeight).
+func TestLeastLoadScoreArithmetic(t *testing.T) {
+	const devA = int64(100 * time.Millisecond)
+	const devB = int64(100 * time.Millisecond)
+
+	s := newLeastLoad(t,
+		&StrategyLeastLoadConfig{
+			Expected: 2,
+			// Weight 4 on "a" => score multiplied by sqrt(4) = 2, so "a" ranks worse
+			// than "b" despite identical deviation.
+			Costs: []*StrategyWeight{{Match: "a", Value: 4}},
+		},
+		status("a", true, 100, 10, 0, devA, int64(100*time.Millisecond)),
+		status("b", true, 100, 10, 0, devB, int64(100*time.Millisecond)),
+	)
+
+	traces := withTracing(t, func() {
+		candidates := []string{"a", "b"}
+		b := newBalancer(s, "leastload", "", candidates)
+		if _, err := b.PickOutboundWithConn(7); err != nil {
+			t.Fatalf("pick: %v", err)
+		}
+	})
+	score := findStage(traces[0], xraytrace.StageScore)
+	if score == nil {
+		t.Fatal("no score stage")
+	}
+
+	wantA := int64(float64(devA) * math.Sqrt(4))
+	if got := score.Scores["a"]; got != wantA {
+		t.Errorf("score[a] = %d, want %d (dev * sqrt(4))", got, wantA)
+	}
+	if got := score.Scores["b"]; got != devB {
+		t.Errorf("score[b] = %d, want %d (dev * sqrt(1))", got, devB)
+	}
+	// Ranking must put the cheaper one first.
+	if len(score.Out) != 2 || score.Out[0] != "b" {
+		t.Errorf("rank order = %v, want b first", score.Out)
+	}
+	// The weight is surfaced in milli-units so the UI can show the arithmetic.
+	if got := score.Params["w:a"]; got != 4000 {
+		t.Errorf("weight[a] = %d, want 4000 (=4.0)", got)
+	}
+}
+
+// TestLeastLoadDeterminismBoundary encodes exactly where determinism ends, which is
+// the same claim the UI makes. Expected=1 with no baselines is a single survivor and
+// must never vary; anything wider goes through dice.Roll and must not be asserted
+// stable.
+func TestLeastLoadDeterminismBoundary(t *testing.T) {
+	mk := func(expected int32) *LeastLoadStrategy {
+		return newLeastLoad(t,
+			&StrategyLeastLoadConfig{Expected: expected},
+			status("a", true, 100, 10, 0, int64(10*time.Millisecond), int64(100*time.Millisecond)),
+			status("b", true, 100, 10, 0, int64(20*time.Millisecond), int64(100*time.Millisecond)),
+			status("c", true, 100, 10, 0, int64(30*time.Millisecond), int64(100*time.Millisecond)),
+		)
+	}
+	candidates := []string{"a", "b", "c"}
+
+	for i := 0; i < 200; i++ {
+		if got := mk(1).PickOutbound(candidates); got != "a" {
+			t.Fatalf("Expected=1 must be deterministic, run %d gave %q", i, got)
+		}
+	}
+
+	seen := map[string]bool{}
+	for i := 0; i < 400; i++ {
+		seen[mk(3).PickOutbound(candidates)] = true
+	}
+	if len(seen) < 2 {
+		t.Fatalf("Expected=3 should draw from all survivors, only ever saw %v", seen)
+	}
+}
+
+// TestLeastPingReportsUnprobedCandidates covers the single most common real-world
+// confusion: leastPing iterates the observation, not the candidate list, so an
+// outbound that was never probed is invisible rather than rejected.
+func TestLeastPingReportsUnprobedCandidates(t *testing.T) {
+	s := &LeastPingStrategy{
+		ctx: context.Background(),
+		observatory: &fakeObservatory{result: &observatory.ObservationResult{
+			Status: []*observatory.OutboundStatus{
+				status("fast", true, 20, 0, 0, 0, 0),
+				status("slow", true, 300, 0, 0, 0, 0),
+			},
+		}},
+	}
+	traces := withTracing(t, func() {
+		candidates := []string{"fast", "slow", "never-probed"}
+		b := newBalancer(s, "leastping", "", candidates)
+		got, err := b.PickOutboundWithConn(7)
+		if err != nil {
+			t.Fatalf("pick: %v", err)
+		}
+		if got != "fast" {
+			t.Fatalf("picked %q, want fast", got)
+		}
+	})
+	scan := findStage(traces[0], xraytrace.StageMinScan)
+	if scan == nil {
+		t.Fatal("no min_scan stage")
+	}
+	if got := rejectionReason(scan, "never-probed"); got != xraytrace.ReasonNotInObservation {
+		t.Errorf("never-probed reason = %q, want %q", got, xraytrace.ReasonNotInObservation)
+	}
+	if got := rejectionReason(scan, "slow"); got != xraytrace.ReasonOutranked {
+		t.Errorf("slow reason = %q, want %q", got, xraytrace.ReasonOutranked)
+	}
+}
+
+// TestRandomWithoutFallbackIgnoresObservatory documents the gate that surprises
+// people: random and roundRobin only consult the observatory when fallbackTag is
+// set, so without it they will happily pick a dead outbound.
+func TestRandomWithoutFallbackIgnoresObservatory(t *testing.T) {
+	// No FallbackTag => InjectContext never wires an observatory => nil.
+	s := &RandomStrategy{ctx: context.Background()}
+
+	traces := withTracing(t, func() {
+		candidates := []string{"a", "b"}
+		b := newBalancer(s, "random", "", candidates)
+		if _, err := b.PickOutboundWithConn(7); err != nil {
+			t.Fatalf("pick: %v", err)
+		}
+	})
+	alive := findStage(traces[0], xraytrace.StageAliveFilter)
+	if alive == nil {
+		t.Fatal("no alive_filter stage")
+	}
+	if alive.Note != xraytrace.NoteObservatoryIgnored {
+		t.Errorf("note = %q, want %q", alive.Note, xraytrace.NoteObservatoryIgnored)
+	}
+	if len(alive.Out) != 2 {
+		t.Errorf("both candidates should survive an ignored filter, got %v", alive.Out)
+	}
+}
+
+// TestRoundRobinUnfoundIsAlive covers the other half of that filter: a candidate the
+// observatory has no record of is treated as ALIVE, not dead.
+func TestRoundRobinUnfoundIsAlive(t *testing.T) {
+	s := &RoundRobinStrategy{
+		FallbackTag: "fb",
+		ctx:         context.Background(),
+		observatory: &fakeObservatory{result: &observatory.ObservationResult{
+			Status: []*observatory.OutboundStatus{
+				status("known-dead", false, 0, 0, 0, 0, 0),
+			},
+		}},
+	}
+	traces := withTracing(t, func() {
+		candidates := []string{"known-dead", "unknown"}
+		b := newBalancer(s, "roundrobin", "fb", candidates)
+		if _, err := b.PickOutboundWithConn(7); err != nil {
+			t.Fatalf("pick: %v", err)
+		}
+	})
+	alive := findStage(traces[0], xraytrace.StageAliveFilter)
+	if alive == nil {
+		t.Fatal("no alive_filter stage")
+	}
+	if len(alive.Out) != 1 || alive.Out[0] != "unknown" {
+		t.Errorf("survivors = %v, want [unknown]", alive.Out)
+	}
+	if alive.Note != xraytrace.NoteUnfoundAssumedAlive {
+		t.Errorf("note = %q, want %q", alive.Note, xraytrace.NoteUnfoundAssumedAlive)
+	}
+	if got := rejectionReason(alive, "known-dead"); got != xraytrace.ReasonNotAlive {
+		t.Errorf("known-dead reason = %q", got)
+	}
+}
