+	}
+
+	score := tr.Begin(xraytrace.StageScore, "rank", order)
+	noHP := false
+	for _, n := range nodes {
+		score.Score(n.Tag, int64(n.RTTDeviationCost))
+		score.Param("w:"+n.Tag, int64(s.costs.Get(n.Tag)*1000)) // milli-units
+		score.Param("dev_ns:"+n.Tag, int64(n.RTTDeviation))
+		score.Param("avg_ns:"+n.Tag, int64(n.RTTAverage))
+		// CountAll==1 && CountFail==1 is the sentinel getNodes uses when HealthPing is
+		// absent, i.e. the plain observatory. Deviation is then the raw delay and
+		// leastLoad degenerates into leastPing with a cost multiplier.
+		if n.CountAll == 1 && n.CountFail == 1 {
+			noHP = true
+		}
+	}
+	score.SetOut(order)
+	if noHP {
+		score.Note(xraytrace.NoteNoHealthPing)
+	}
+	score.End(tr)
+
+	sortSt := tr.Begin(xraytrace.StageSort, "rank", order)
+	sortSt.SetOut(order)
+	// The comparator is a total order (RTTDeviationCost, RTTAverage, CountFail,
+	// CountAll desc, Tag), so for every adjacent pair we can say exactly which key
+	// decided it — no "it just came out that way".
+	for i := 1; i < len(nodes); i++ {
+		sortSt.Param("tiebreak:"+nodes[i-1].Tag+">"+nodes[i].Tag, int64(tiebreakKey(nodes[i-1], nodes[i])))
+	}
+	sortSt.End(tr)
+}
+
+// tiebreakKey reports which comparator key separated two adjacent nodes:
+// 0 cost, 1 average, 2 fail count, 3 sample count, 4 tag.
+func tiebreakKey(a, b *node) int {
+	switch {
+	case a.RTTDeviationCost != b.RTTDeviationCost:
+		return 0
+	case a.RTTAverage != b.RTTAverage:
+		return 1
+	case a.CountFail != b.CountFail:
+		return 2
+	case a.CountAll != b.CountAll:
+		return 3
+	default:
+		return 4
 	}
-	return true
 }
 
