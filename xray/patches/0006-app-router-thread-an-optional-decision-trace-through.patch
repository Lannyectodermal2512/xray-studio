+// traceMinScan explains the linear minimum scan above. It is pure reporting — it
+// re-derives nothing that affects the choice.
+//
+// The important thing it surfaces is the asymmetry in upstream's loop: it iterates
+// the OBSERVATION, not the candidate list. An outbound that has never been probed
+// therefore never appears and can never be picked, with no error and no log line.
+func (l *LeastPingStrategy) traceMinScan(candidates []string, status []*observatory.OutboundStatus, winner string, winnerDelay int64, tr *xraytrace.Trace) {
+	byTag := make(map[string]*observatory.OutboundStatus, len(status))
+	for _, v := range status {
+		byTag[v.OutboundTag] = v
+	}
+
+	st := tr.Begin(xraytrace.StageMinScan, "rank", candidates)
+	ties := 0
+	for _, tag := range candidates {
+		v, found := byTag[tag]
+		if !found {
+			st.Drop(tag, xraytrace.ReasonNotInObservation, nil)
+			continue
+		}
+		st.Score(tag, v.Delay)
+		if !v.Alive {
+			st.Drop(tag, xraytrace.ReasonNotAlive, map[string]int64{"delay_ms": v.Delay})
+			continue
+		}
+		if tag == winner {
+			st.Keep(tag)
+			continue
+		}
+		st.Drop(tag, xraytrace.ReasonOutranked, map[string]int64{
+			"delay_ms": v.Delay, "winner_delay_ms": winnerDelay,
+		})
+		if v.Delay == winnerDelay {
+			ties++
+		}
+	}
+	if winner != "" {
+		st.Param("winner_delay_ms", winnerDelay)
+	}
+	if ties > 0 {
+		// The scan uses a strict `<`, so the FIRST entry at the winning delay wins —
+		// and under the burst observatory the iteration order comes from a Go map
+		// range, which is re-randomised on every call. Tie order is not stable.
+		st.Param("tied_with_winner", int64(ties))
+		st.Note(xraytrace.NoteTie)
+	}
+	if winner == "" {
+		st.Note(xraytrace.NoteEmpty)
+	}
+	st.End(tr)
+}
