+// TestBalancerFallbackAndErrorAreTraced covers the terminal paths, including the one
+// whose error text upstream used to discard entirely.
+func TestBalancerFallbackAndErrorAreTraced(t *testing.T) {
+	// A leastLoad with no observatory returns "" for everything.
+	broken := func() *LeastLoadStrategy {
+		s := NewLeastLoadStrategy(&StrategyLeastLoadConfig{Expected: 1})
+		s.ctx = context.Background()
+		return s // observer stays nil
+	}
+
+	t.Run("fallback", func(t *testing.T) {
+		traces := withTracing(t, func() {
+			candidates := []string{"a"}
+			b := newBalancer(broken(), "leastload", "fb", candidates)
+			got, err := b.PickOutboundWithConn(7)
+			if err != nil || got != "fb" {
+				t.Fatalf("got %q, %v; want fb, nil", got, err)
+			}
+		})
+		if traces[0].Source != xraytrace.SourceFallback {
+			t.Errorf("source = %q, want %q", traces[0].Source, xraytrace.SourceFallback)
+		}
+		if obs := findStage(traces[0], xraytrace.StageObservation); obs == nil || obs.Note != xraytrace.NoteObservatoryNil {
+			t.Errorf("expected an observatory_nil note, stages=%v", traces[0].Stages)
+		}
+	})
+
+	t.Run("error", func(t *testing.T) {
+		traces := withTracing(t, func() {
+			candidates := []string{"a"}
+			b := newBalancer(broken(), "leastload", "", candidates)
+			if _, err := b.PickOutboundWithConn(7); err == nil {
+				t.Fatal("expected an error with no fallbackTag")
+			}
+		})
+		if traces[0].Source != xraytrace.SourceError {
+			t.Errorf("source = %q, want %q", traces[0].Source, xraytrace.SourceError)
+		}
+		if traces[0].Err == "" {
+			t.Error("error text must reach the trace; this is what upstream used to drop")
+		}
+	})
+}
