+	"github.com/xtls/xray-core/xraytrace"
+	"google.golang.org/protobuf/proto"
+)
+
+// These tests guard the property the whole UI rests on: the decision trace describes
+// the decision that was actually made.
+//
+// That property is mostly structural — PickOutbound and PickOutboundTraced are the
+// same function, so there is no second implementation to drift. What still needs
+// testing is that (a) enabling tracing does not change the outcome, and (b) the
+// stages report the right reasons and the right arithmetic.
+
+// fakeOhm is an outbound.Manager that only implements what a Balancer needs:
+// HandlerSelector.Select. Everything else panics loudly rather than silently
+// returning a zero value, so a future change that starts using them is obvious.
+type fakeOhm struct{ tags []string }
+
+func (f *fakeOhm) Select([]string) []string                           { return f.tags }
+func (f *fakeOhm) Type() interface{}                                  { return outbound.ManagerType() }
+func (f *fakeOhm) Start() error                                       { return nil }
+func (f *fakeOhm) Close() error                                       { return nil }
+func (f *fakeOhm) GetHandler(string) outbound.Handler                 { panic("unused") }
+func (f *fakeOhm) GetDefaultHandler() outbound.Handler                { panic("unused") }
+func (f *fakeOhm) AddHandler(context.Context, outbound.Handler) error { panic("unused") }
+func (f *fakeOhm) RemoveHandler(context.Context, string) error        { panic("unused") }
+func (f *fakeOhm) ListHandlers(context.Context) []outbound.Handler    { panic("unused") }
+
+// newBalancer builds a Balancer over a fixed candidate set, exercising the real
+// PickOutboundWithConn path rather than calling the strategy directly.
+func newBalancer(strategy BalancingStrategy, name, fallback string, candidates []string) *Balancer {
+	return &Balancer{
+		selectors:    []string{"*"},
+		strategy:     strategy,
+		ohm:          &fakeOhm{tags: candidates},
+		fallbackTag:  fallback,
+		tag:          "bal",
+		strategyName: name,
+	}
+}
+
+type fakeObservatory struct {
+	result *observatory.ObservationResult
+}
+
+func (f *fakeObservatory) Type() interface{} { return extension.ObservatoryType() }
+func (f *fakeObservatory) Start() error      { return nil }
+func (f *fakeObservatory) Close() error      { return nil }
+func (f *fakeObservatory) GetObservation(context.Context) (proto.Message, error) {
+	return f.result, nil
+}
+
+func status(tag string, alive bool, delayMs int64, all, fail int64, devNs, avgNs int64) *observatory.OutboundStatus {
+	s := &observatory.OutboundStatus{OutboundTag: tag, Alive: alive, Delay: delayMs}
+	if all > 0 {
+		s.HealthPing = &observatory.HealthPingMeasurementResult{
+			All: all, Fail: fail, Deviation: devNs, Average: avgNs,
+		}
+	}
+	return s
+}
+
+// withTracing enables the hook for the duration of fn and returns the traces seen.
+func withTracing(t *testing.T, fn func()) []*xraytrace.Trace {
+	t.Helper()
+	var got []*xraytrace.Trace
+	xraytrace.OnBalancerEval = func(tr *xraytrace.Trace) { got = append(got, tr) }
+	t.Cleanup(func() { xraytrace.OnBalancerEval = nil })
+	fn()
+	return got
+}
+
+func newLeastLoad(t *testing.T, settings *StrategyLeastLoadConfig, st ...*observatory.OutboundStatus) *LeastLoadStrategy {
+	t.Helper()
+	s := NewLeastLoadStrategy(settings)
+	s.ctx = context.Background()
+	s.observer = &fakeObservatory{result: &observatory.ObservationResult{Status: st}}
+	return s
+}
+
+func findStage(tr *xraytrace.Trace, id string) *xraytrace.Stage {
+	for i := range tr.Stages {
+		if tr.Stages[i].ID == id {
+			return &tr.Stages[i]
+		}
+	}
+	return nil
+}
+
+func rejectionReason(st *xraytrace.Stage, tag string) string {
+	if st == nil {
+		return ""
+	}
+	for _, r := range st.Rejected {
+		if r.Tag == tag {
+			return r.Reason
+		}
+	}
+	return ""
+}
+
+// TestTracingDoesNotChangeOutcome is the important one: for a configuration that is
+// fully deterministic, the tag chosen must be identical with tracing on and off.
+func TestTracingDoesNotChangeOutcome(t *testing.T) {
+	mk := func() *LeastLoadStrategy {
+		return newLeastLoad(t,
+			&StrategyLeastLoadConfig{Expected: 1},
+			status("a", true, 100, 10, 0, int64(40*time.Millisecond), int64(100*time.Millisecond)),
+			status("b", true, 50, 10, 0, int64(20*time.Millisecond), int64(50*time.Millisecond)),
+			status("c", true, 200, 10, 0, int64(90*time.Millisecond), int64(200*time.Millisecond)),
+		)
+	}
+	candidates := []string{"a", "b", "c"}
+
+	untraced := mk().PickOutbound(candidates)
+
+	var traced string
+	traces := withTracing(t, func() {
+		// Route through the Balancer so the full path is exercised, not just the strategy.
+		b := newBalancer(mk(), "leastload", "", candidates)
+		var err error
+		traced, err = b.PickOutboundWithConn(7)
+		if err != nil {
+			t.Fatalf("traced pick: %v", err)
+		}
+	})
+
+	if untraced != traced {
+		t.Fatalf("tracing changed the outcome: untraced=%q traced=%q", untraced, traced)
+	}
+	if untraced != "b" {
+		t.Fatalf("expected lowest deviation 'b', got %q", untraced)
+	}
+	if len(traces) != 1 {
+		t.Fatalf("expected exactly 1 trace, got %d", len(traces))
+	}
+	if traces[0].Selected != traced {
+		t.Fatalf("trace reports %q but pick returned %q", traces[0].Selected, traced)
+	}
+	if traces[0].Source != xraytrace.SourceStrategy {
+		t.Fatalf("unexpected source %q", traces[0].Source)
+	}
+}
