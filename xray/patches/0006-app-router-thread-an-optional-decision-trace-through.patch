+// PickOutboundTraced implements TracingStrategy. Same code path as PickOutbound.
+func (s *RoundRobinStrategy) PickOutboundTraced(tags []string, tr *xraytrace.Trace) string {
+	tags = aliveFilter(s.observatory, s.ctx, s.FallbackTag, tags, tr)
 
 	n := len(tags)
 	if n == 0 {
 		// goes to fallbackTag
+		if tr.On() {
+			st := tr.Begin(xraytrace.StageRRIndex, "choose", tags)
+			st.Note(xraytrace.NoteEmpty)
+			st.End(tr)
+		}
 		return ""
 	}
 
 	s.mu.Lock()
 	defer s.mu.Unlock()
+	before := s.index
 	tag := tags[s.index%n]
 	s.index = (s.index + 1) % n
+
+	if tr.On() {
+		st := tr.Begin(xraytrace.StageRRIndex, "choose", tags)
+		st.Keep(tag)
+		st.Param("index_before", int64(before))
+		st.Param("index_after", int64(s.index))
+		st.Param("n", int64(n))
+		for _, t := range tags {
+			if t != tag {
+				st.Drop(t, xraytrace.ReasonNotCurrentIndex, nil)
+			}
+		}
+		// The index is taken modulo the POST-FILTER list, which is rebuilt on every
+		// call. When an outbound dies or revives, n changes and the rotation jumps —
+		// it is not a stable cursor over a stable set, and a tag can repeat.
+		if before >= n {
+			st.Note(xraytrace.NoteRRIndexJumped)
+		}
+		st.End(tr)
+	}
 	return tag
 }
 
+// aliveFilter is the liveness filter shared by random and roundRobin.
+//
+// Two behaviours here reliably surprise people, so both are recorded:
+//   - The observatory is only consulted when fallbackTag is set (observatory stays
+//     nil otherwise), so without it these strategies happily pick dead outbounds.
+//   - A candidate absent from the observation is treated as ALIVE, not dead.
+func aliveFilter(obs extension.Observatory, ctx context.Context, fallbackTag string, tags []string, tr *xraytrace.Trace) []string {
+	if obs == nil {
+		if tr.On() {
+			st := tr.Begin(xraytrace.StageAliveFilter, "filter", tags)
+			st.SetOut(tags)
+			if fallbackTag == "" {
+				st.Note(xraytrace.NoteObservatoryIgnored)
+			} else {
+				st.Note(xraytrace.NoteObservatoryNil)
+			}
+			st.End(tr)
+		}
+		return tags
+	}
+
+	observeReport, err := obs.GetObservation(ctx)
+	if err != nil {
+		// Upstream silently skips the whole filter on error and uses the raw list.
+		if tr.On() {
+			st := tr.Begin(xraytrace.StageAliveFilter, "filter", tags)
+			st.SetOut(tags)
+			st.Note(xraytrace.NoteObservationError)
+			st.End(tr)
+		}
+		return tags
+	}
+
+	result, ok := observeReport.(*observatory.ObservationResult)
+	if !ok {
+		if tr.On() {
+			st := tr.Begin(xraytrace.StageAliveFilter, "filter", tags)
+			st.SetOut(tags)
+			st.Note(xraytrace.NoteObservationError)
+			st.End(tr)
+		}
+		return tags
+	}
+	tr.SetObservation(observationRows(result))
+
+	statusMap := make(map[string]*observatory.OutboundStatus)
+	for _, outboundStatus := range result.Status {
+		statusMap[outboundStatus.OutboundTag] = outboundStatus
+	}
+
+	st := tr.Begin(xraytrace.StageAliveFilter, "filter", tags)
+	aliveTags := make([]string, 0)
+	unfound := false
+	for _, candidate := range tags {
+		if outboundStatus, found := statusMap[candidate]; found {
+			if outboundStatus.Alive {
+				aliveTags = append(aliveTags, candidate)
+				st.Keep(candidate)
+			} else {
+				st.Drop(candidate, xraytrace.ReasonNotAlive, map[string]int64{"delay_ms": outboundStatus.Delay})
+			}
+		} else {
+			// unfound candidate is considered alive
+			aliveTags = append(aliveTags, candidate)
+			st.Keep(candidate)
+			unfound = true
+		}
+	}
+	if unfound {
+		st.Note(xraytrace.NoteUnfoundAssumedAlive)
+	}
+	st.End(tr)
+	return aliveTags
+}
