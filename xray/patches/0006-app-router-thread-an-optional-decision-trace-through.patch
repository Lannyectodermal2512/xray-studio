+// TracingStrategy is implemented by strategies that can explain their choice.
+//
+// The traced method is the SAME code path as PickOutbound — PickOutbound simply
+// calls it with a nil trace, and every *xraytrace.Trace method is nil-safe. There is
+// deliberately no second implementation of any balancing algorithm: a parallel
+// "explaining" copy could drift from the real one, and the UI would then present the
+// drift as ground truth.
+type TracingStrategy interface {
+	PickOutboundTraced([]string, *xraytrace.Trace) string
+}
+
+// pickWithTrace routes through the traced path when the strategy supports it.
+func pickWithTrace(s BalancingStrategy, candidates []string, tr *xraytrace.Trace) string {
+	if ts, ok := s.(TracingStrategy); ok {
+		return ts.PickOutboundTraced(candidates, tr)
+	}
+	return s.PickOutbound(candidates)
+}
+
+// observationRows flattens an observatory result for a trace. The observatory mutates
+// its records continuously, so this copies rather than referencing: the snapshot must
+// describe the decision that was actually made.
+func observationRows(result *observatory.ObservationResult) []xraytrace.ObsRow {
+	if result == nil {
+		return nil
+	}
+	rows := make([]xraytrace.ObsRow, 0, len(result.Status))
+	for _, s := range result.Status {
+		row := xraytrace.ObsRow{
+			Tag:     s.OutboundTag,
+			Alive:   s.Alive,
+			DelayMs: s.Delay,
+			LastErr: s.LastErrorReason,
+		}
+		if hp := s.HealthPing; hp != nil {
+			row.HasHP = true
+			row.All, row.Fail = hp.All, hp.Fail
+			row.AvgNs, row.DevNs, row.MaxNs, row.MinNs = hp.Average, hp.Deviation, hp.Max, hp.Min
+		}
+		rows = append(rows, row)
+	}
+	return rows
+}
