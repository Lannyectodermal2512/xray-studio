+	return b.PickOutboundWithConn(0)
+}
+
+// PickOutboundWithConn is PickOutbound, attributing the decision to a connection id
+// so the trace can be joined to the rest of that connection's story.
+//
+// When xraytrace.OnBalancerEval is unset, NewTrace returns nil, every trace call is a
+// nil-check, and this behaves exactly as unpatched upstream.
+func (b *Balancer) PickOutboundWithConn(connID uint32) (string, error) {
+	tr := xraytrace.NewTrace(b.tag, b.strategyName, b.fallbackTag, connID)
+
 	candidates, err := b.SelectOutbounds()
 	if err != nil {
 		if b.fallbackTag != "" {
 			errors.LogInfo(context.Background(), "fallback to [", b.fallbackTag, "], due to error: ", err)
+			tr.Finish(b.fallbackTag, xraytrace.SourceFallbackErr, err.Error())
+			xraytrace.Eval(tr)
 			return b.fallbackTag, nil
 		}
+		tr.Finish("", xraytrace.SourceError, err.Error())
+		xraytrace.Eval(tr)
 		return "", err
 	}
+	tr.SetCandidates(b.selectors, candidates)
+
 	var tag string
 	if o := b.override.Get(); o != "" {
+		// Note the override is returned unvalidated: it is not checked for membership
+		// in candidates, for existence, or for liveness. Pinning a nonexistent tag
+		// kills the connection outright rather than falling back.
 		tag = o
-	} else {
-		tag = b.strategy.PickOutbound(candidates)
+		if tr.On() {
+			st := tr.Begin(xraytrace.StageSelect, "choose", candidates)
+			st.Keep(o)
+			st.Note("override_pinned")
+			st.End(tr)
+		}
+		tr.Finish(tag, xraytrace.SourceOverride, "")
+		xraytrace.Eval(tr)
+		return tag, nil
 	}
+
+	tag = pickWithTrace(b.strategy, candidates, tr)
 	if tag == "" {
 		if b.fallbackTag != "" {
 			errors.LogInfo(context.Background(), "fallback to [", b.fallbackTag, "], due to empty tag returned")
+			tr.Finish(b.fallbackTag, xraytrace.SourceFallback, "")
+			xraytrace.Eval(tr)
 			return b.fallbackTag, nil
 		}
 		// will use default handler
-		return "", errors.New("balancing strategy returns empty tag")
+		err := errors.New("balancing strategy returns empty tag")
+		tr.Finish("", xraytrace.SourceError, err.Error())
+		xraytrace.Eval(tr)
+		return "", err
 	}
+	tr.Finish(tag, xraytrace.SourceStrategy, "")
+	xraytrace.Eval(tr)
 	return tag, nil
 }
 
